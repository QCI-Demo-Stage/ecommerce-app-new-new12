PORT=3000
NODE_ENV=development
APP_VERSION=0.0.0

# JWT secrets — use long random values in every environment; never commit real secrets
JWT_ACCESS_SECRET=change-me-access-secret-min-32-chars
JWT_REFRESH_SECRET=change-me-refresh-secret-min-32-chars
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# bcrypt cost factor (10–12 recommended for production)
BCRYPT_SALT_ROUNDS=12

# Stripe — use test/sandbox secret key locally (sk_test_…). Never commit real keys.
STRIPE_SECRET_KEY=sk_test_replace_with_sandbox_secret
STRIPE_PUBLISHABLE_KEY=pk_test_replace_with_sandbox_publishable
