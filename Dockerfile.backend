# syntax=docker/dockerfile:1.7
# Multi-arch backend image (linux/amd64, linux/arm64) via docker buildx.
# Build: docker buildx build --platform linux/amd64,linux/arm64 -f Dockerfile.backend -t <image> .

ARG NODE_VERSION=20

# -----------------------------------------------------------------------------
# Dependencies
# -----------------------------------------------------------------------------
FROM node:${NODE_VERSION}-alpine AS deps
WORKDIR /app

COPY backend/package.json backend/package-lock.json* ./
RUN npm ci --omit=dev || npm install --omit=dev

# -----------------------------------------------------------------------------
# Build (TypeScript compile)
# -----------------------------------------------------------------------------
FROM node:${NODE_VERSION}-alpine AS build
WORKDIR /app

ARG BUILD_VERSION=dev
ARG BUILD_SHA=unknown
ENV BUILD_VERSION=${BUILD_VERSION} BUILD_SHA=${BUILD_SHA}

COPY backend/package.json backend/package-lock.json* ./
RUN npm ci || npm install

COPY backend/tsconfig.json ./
COPY backend/src ./src
RUN npm run build

# -----------------------------------------------------------------------------
# Runtime
# -----------------------------------------------------------------------------
FROM node:${NODE_VERSION}-alpine AS runtime
WORKDIR /app

ARG BUILD_VERSION=dev
ARG BUILD_SHA=unknown
ARG PORT=3001

ENV NODE_ENV=production \
    PORT=${PORT} \
    BUILD_VERSION=${BUILD_VERSION} \
    BUILD_SHA=${BUILD_SHA}

RUN addgroup -S app && adduser -S app -G app

COPY --from=deps /app/node_modules ./node_modules
COPY --from=build /app/dist ./dist
COPY backend/package.json ./

USER app
EXPOSE ${PORT}

HEALTHCHECK --interval=30s --timeout=5s --start-period=10s --retries=3 \
  CMD wget -qO- "http://127.0.0.1:${PORT}/health" || exit 1

CMD ["node", "dist/index.js"]
