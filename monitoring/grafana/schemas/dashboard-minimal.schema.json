{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "GrafanaDashboardMinimal",
  "type": "object",
  "required": [
    "title",
    "uid",
    "schemaVersion",
    "panels",
    "timezone",
    "time",
    "tags"
  ],
  "properties": {
    "title": { "type": "string", "minLength": 1 },
    "uid": { "type": "string", "minLength": 1 },
    "schemaVersion": { "type": "integer", "minimum": 16 },
    "timezone": { "type": "string" },
    "tags": {
      "type": "array",
      "items": { "type": "string" }
    },
    "time": {
      "type": "object",
      "required": ["from", "to"],
      "properties": {
        "from": { "type": "string" },
        "to": { "type": "string" }
      }
    },
    "panels": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "type", "title", "gridPos", "targets"],
        "properties": {
          "id": { "type": "integer" },
          "type": { "type": "string" },
          "title": { "type": "string" },
          "gridPos": {
            "type": "object",
            "required": ["h", "w", "x", "y"],
            "properties": {
              "h": { "type": "integer" },
              "w": { "type": "integer" },
              "x": { "type": "integer" },
              "y": { "type": "integer" }
            }
          },
          "targets": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "required": ["expr", "refId"],
              "properties": {
                "expr": { "type": "string", "minLength": 1 },
                "refId": { "type": "string", "minLength": 1 },
                "legendFormat": { "type": "string" }
              }
            }
          }
        }
      }
    },
    "refresh": { "type": "string" },
    "version": { "type": "integer" }
  },
  "additionalProperties": true
}
