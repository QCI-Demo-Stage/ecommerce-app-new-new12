{
  "name": "ecommerce-app-new",
  "version": "0.1.0",
  "description": "Ecommerce App New — schema migrations and payment service docs",
  "private": true,
  "type": "commonjs",
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "typecheck:migrations": "tsc --noEmit -p tsconfig.migrations.json",
    "verify:sql": "tsx scripts/verify-sql-syntax.ts",
    "verify": "npm run typecheck:migrations && npm run verify:sql",
    "lint:openapi": "redocly lint docs/openapi/payment-service.yaml",
    "migrate:up": "node-pg-migrate up",
    "migrate:down": "node-pg-migrate down",
    "migrate:create": "node-pg-migrate create"
  },
  "dependencies": {
    "dotenv": "^16.4.7",
    "node-pg-migrate": "^7.9.1",
    "pg": "^8.13.1"
  },
  "devDependencies": {
    "@redocly/cli": "^1.27.2",
    "@types/node": "^22.10.5",
    "@types/pg": "^8.11.10",
    "tsx": "^4.19.2",
    "typescript": "^5.7.3"
  }
}
