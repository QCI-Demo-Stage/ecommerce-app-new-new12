{
  "name": "ecommerce-app-new",
  "version": "1.0.0",
  "description": "Ecommerce backend data layer — PostgreSQL schema, migrations, and seeds",
  "private": true,
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "lint": "eslint \"migrations/**/*.ts\" \"src/**/*.ts\" \"seeds/**/*.ts\"",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "migrate:up": "node-pg-migrate up -m migrations --migration-file-language ts --tsconfig tsconfig.json",
    "migrate:down": "node-pg-migrate down -m migrations --migration-file-language ts --tsconfig tsconfig.json",
    "migrate:create": "node-pg-migrate create -m migrations --migration-file-language ts",
    "migrate:redo": "node-pg-migrate redo -m migrations --migration-file-language ts --tsconfig tsconfig.json",
    "db:seed": "tsx seeds/seed.ts",
    "db:reset": "npm run migrate:down -- --all && npm run migrate:up && npm run db:seed",
    "db:validate": "npm run typecheck && npm run lint && npm run migrate:up && npm run db:seed"
  },
  "dependencies": {
    "bcryptjs": "^3.0.2",
    "dotenv": "^16.4.7",
    "pg": "^8.13.3"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/node": "^22.13.10",
    "@types/pg": "^8.11.11",
    "@typescript-eslint/eslint-plugin": "^8.26.1",
    "@typescript-eslint/parser": "^8.26.1",
    "eslint": "^9.22.0",
    "node-pg-migrate": "^7.9.1",
    "ts-node": "^10.9.2",
    "tsx": "^4.19.3",
    "typescript": "^5.8.2",
    "typescript-eslint": "^8.26.1"
  }
}
